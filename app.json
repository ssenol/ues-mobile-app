{
  "expo": {
    "entryPoint": "./App.js",
    "name": "BoostifySpeak",
    "slug": "boostifyspeak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "background": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Bu uygulama Face ID ile giriş yapmanıza izin verir.",
        "NSMicrophoneUsageDescription": "Uygulama, sesinizi kaydedip telaffuzunuzu değerlendirmek için mikrofonunuza erişim gerektirir.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ues.uesmobileapp",
      "buildNumber": "10"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "background": "#ffffff"
      },
      "package": "com.ues.uesmobileapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "owner": "selcuksenol",
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b265e6b9-bacb-437b-b64f-53554b99a0dc"
      }
    }
  }
}
